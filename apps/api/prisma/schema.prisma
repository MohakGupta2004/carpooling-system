generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================
// Tenancy & identity
// ============================================================
model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  domain          String?
  logoUrl         String?
  status          OrgStatus        @default(ACTIVE)
  permVersion     Int              @default(1) // bump to invalidate RBAC cache org-wide
  workingHours    Json?
  holidays        Json?
  ridePolicies    Json?
  fuelCostRules   Json?
  travelAllowance Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           User[]
  departments     Department[]
  officeLocations OfficeLocation[]
  roles           Role[]
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
}

model OfficeLocation {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String
  lat            Decimal
  lng            Decimal
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String?
  emailVerified  Boolean      @default(false)
  otpCode        String?
  otpExpiresAt   DateTime?
  status         UserStatus   @default(PENDING)
  fullName       String
  photoUrl       String?
  phone          String?
  gender         Gender?
  employeeCode   String?
  departmentId   String?
  homeAddress    String?
  homeLat        Decimal?
  homeLng        Decimal?
  emergencyName  String?
  emergencyPhone String?
  preferences    Json?
  ecoPoints      Int          @default(0)
  rating         Decimal      @default(0)
  authProvider   AuthProvider @default(LOCAL)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department          Department?      @relation(fields: [departmentId], references: [id])
  roles               UserRole[]
  permissionOverrides UserPermission[]
  vehicles            Vehicle[]
  ridesOffered        Ride[]           @relation("driver")
  bookings            Booking[]
  wallet              Wallet?
  sessions            Session[]
  savedPlaces         SavedPlace[]
  reviewsGiven        Review[]         @relation("rater")
  reviewsReceived     Review[]         @relation("ratee")
  notifications       Notification[]
  sosEvents           SosEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Dynamic RBAC
// ============================================================
model Role {
  id             String           @id @default(cuid())
  organizationId String?
  key            String
  name           String
  isSystem       Boolean          @default(false)
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, key])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  resource        String
  action          String
  description     String?
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermEffect @default(ALLOW)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  target         String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ============================================================
// Vehicles
// ============================================================
model Vehicle {
  id             String             @id @default(cuid())
  organizationId String
  ownerId        String
  type           VehicleType
  brand          String
  model          String
  registrationNo String
  licenseNo      String
  driverName     String
  isAc           Boolean?
  color          String?
  fuelType       FuelType
  seats          Int
  insuranceNo    String?
  pucValidTill   DateTime?
  photos         String[]
  verification   VerificationStatus @default(PENDING)
  // Proposed edits from the owner awaiting admin review (verified vehicles stay
  // live with their approved values until the admin approves the changes).
  pendingChanges Json?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rides          Ride[]

  @@index([organizationId, ownerId])
}

// ============================================================
// Rides / bookings / trips
// ============================================================
model Ride {
  id             String     @id @default(cuid())
  organizationId String
  driverId       String
  vehicleId      String
  originLabel    String
  originLat      Decimal
  originLng      Decimal
  destLabel      String
  destLat        Decimal
  destLng        Decimal
  stops          Json?
  routePolyline  String?
  distanceM      Int?
  durationS      Int?
  departAt       DateTime
  recurrence     Json?
  totalSeats     Int
  seatsAvailable Int
  farePerSeat    Int
  rules          Json?
  bookingMode    BookingMode @default(INSTANT)
  status         RideStatus  @default(PUBLISHED)
  // How far off the direct route the driver will detour to pick a passenger up (m).
  maxDetourM     Int         @default(3000)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // PostGIS: generated geography points (auto-derived from lat/lng), GIST-indexed
  // for fast ST_DWithin radius matching. Read-only from Prisma's perspective.
  originGeo Unsupported("geography(Point, 4326)")?
  destGeo   Unsupported("geography(Point, 4326)")?
  // Full road route as a LineString (populated in app from the polyline). Used
  // for corridor matching: ST_DWithin(routeGeo, pickup, tolerance).
  routeGeo  Unsupported("geography(LineString, 4326)")?

  driver   User      @relation("driver", fields: [driverId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  bookings Booking[]
  trip     Trip?

  @@index([organizationId, status, departAt])
}

model Booking {
  id          String        @id @default(cuid())
  rideId      String
  passengerId String
  seats       Int           @default(1)
  pickupLabel String
  pickupLat   Decimal
  pickupLng   Decimal
  dropLabel   String
  dropLat     Decimal
  dropLng     Decimal
  fareAmount  Int
  status      BookingStatus @default(CONFIRMED)
  pickupOtp        String?
  pickupVerifiedAt DateTime?
  createdAt   DateTime      @default(now())

  // PostGIS generated geography points (see Ride).
  pickupGeo Unsupported("geography(Point, 4326)")?
  dropGeo   Unsupported("geography(Point, 4326)")?

  ride        Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger   User          @relation(fields: [passengerId], references: [id])
  payment     Payment?
  reviews     Review[]

  @@unique([rideId, passengerId])
  @@index([passengerId, status])
}

model Trip {
  id              String         @id @default(cuid())
  rideId          String         @unique
  status          TripStatus     @default(BOOKED)
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  lastLat         Decimal?
  lastLng         Decimal?
  lastSpeed       Decimal?
  etaSeconds      Int?
  actualDistanceM Int?
  ride            Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)
  locations       TripLocation[]
  metric          TripMetric?

  @@index([status])
}

model TripLocation {
  id      String   @id @default(cuid())
  tripId  String
  lat     Decimal
  lng     Decimal
  speed   Decimal?
  heading Decimal?
  at      DateTime @default(now())
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
}

// ============================================================
// Wallet & payments
// ============================================================
model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  currency     String              @default("INR")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  type         TxnType
  amount       Int
  balanceAfter Int
  reference    String?
  note         String?
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  bookingId         String        @unique
  payerId           String
  amount            Int
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerOrderId   String?
  providerPaymentId String?
  invoiceNo         String?
  createdAt         DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ============================================================
// Comms / reviews / places / safety
// ============================================================
model Conversation {
  id        String    @id @default(cuid())
  tripId    String    @unique
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  body           String?
  mediaUrl       String?
  lat            Decimal?
  lng            Decimal?
  readBy         String[]
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  channel   String[]
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Review {
  id        String     @id @default(cuid())
  bookingId String
  raterId   String
  rateeId   String
  role      ReviewRole
  rating    Int
  comment   String?
  createdAt DateTime   @default(now())
  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rater     User       @relation("rater", fields: [raterId], references: [id])
  ratee     User       @relation("ratee", fields: [rateeId], references: [id])

  // One review per direction: passenger→driver (DRIVER) and driver→passenger (PASSENGER).
  @@unique([bookingId, role])
  @@index([rateeId])
}

model SavedPlace {
  id      String  @id @default(cuid())
  userId  String
  label   String
  address String
  lat     Decimal
  lng     Decimal
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SosEvent {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  lat       Decimal?
  lng       Decimal?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Analytics / sustainability
// ============================================================
model TripMetric {
  id                    String   @id @default(cuid())
  organizationId        String
  tripId                String   @unique
  departmentId          String?
  distanceM             Int
  seatsFilled           Int
  soloBaselineDistanceM Int
  fuelSavedMl           Int
  co2SavedG             Int
  costPerKm             Int
  createdAt             DateTime @default(now())
  trip                  Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================================
// Enums
// ============================================================
enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_SAY
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

enum PermEffect {
  ALLOW
  DENY
}

enum VehicleType {
  CAR
  BIKE
  EV
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingMode {
  INSTANT
  APPROVAL
}

enum RideStatus {
  DRAFT
  PUBLISHED
  FULL
  STARTED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  BOOKED
  CONFIRMED
  DRIVER_STARTED
  PASSENGER_PICKED
  IN_PROGRESS
  REACHED
  COMPLETED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  CANCELLED
}

enum TxnType {
  RECHARGE
  RIDE_DEBIT
  REFUND
  CREDIT_BONUS
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  RIDE_INFO
}

enum ReviewRole {
  DRIVER
  PASSENGER
}
